# 统一换行：源码用 LF，Windows 脚本用 CRLF
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# 二进制（别让 git 尝试 diff / 转换）
*.glb binary
*.gltf binary
*.fbx binary
*.obj binary
*.stl binary
*.ply binary
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.zip binary

# 锁文件不参与 diff 统计
package-lock.json -diff linguist-generated
